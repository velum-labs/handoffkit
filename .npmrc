engine-strict=true
package-manager-strict=true
strict-peer-dependencies=true
auto-install-peers=false
ignore-scripts=true
verify-store-integrity=true
prefer-frozen-lockfile=true
minimum-release-age=1440
save-exact=true
minimum-release-age-exclude[]=@velum-labs/model-fusion-protocol
minimum-release-age-exclude[]=@velum-labs/cursorkit
minimum-release-age-exclude[]=@velum-labs/routekit
minimum-release-age-exclude[]=@velum-labs/routekit-accounts
minimum-release-age-exclude[]=@velum-labs/routekit-cli-core
minimum-release-age-exclude[]=@velum-labs/routekit-cli-ui
minimum-release-age-exclude[]=@velum-labs/routekit-config
minimum-release-age-exclude[]=@velum-labs/routekit-config-core
minimum-release-age-exclude[]=@velum-labs/routekit-contracts
minimum-release-age-exclude[]=@velum-labs/routekit-control
minimum-release-age-exclude[]=@velum-labs/routekit-daemon
minimum-release-age-exclude[]=@velum-labs/routekit-gateway
minimum-release-age-exclude[]=@velum-labs/routekit-harness-core
minimum-release-age-exclude[]=@velum-labs/routekit-registry
minimum-release-age-exclude[]=@velum-labs/routekit-router
minimum-release-age-exclude[]=@velum-labs/routekit-runtime
minimum-release-age-exclude[]=@velum-labs/routekit-telemetry-core
minimum-release-age-exclude[]=@velum-labs/routekit-tool-claude
minimum-release-age-exclude[]=@velum-labs/routekit-tool-codex
minimum-release-age-exclude[]=@velum-labs/routekit-tool-cursor
minimum-release-age-exclude[]=@velum-labs/routekit-tool-opencode
